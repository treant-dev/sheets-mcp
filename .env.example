# Copy to .env and fill in. Never commit the real thing.

# The externally visible origin. Must match exactly what clients connect to:
# it becomes the OAuth issuer, the audience of every token, and the base of the
# Google redirect URI.
PUBLIC_BASE_URL=https://sheets-mcp.treant.dev

# HS256 key signing every token. All OAuth state lives inside those tokens, so
# changing this logs everyone out. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=

# Google OAuth client (Web application) — used only to sign users in.
# Authorised redirect URI: https://sheets-mcp.treant.dev/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Service-account key that actually reads and writes the spreadsheets.
# Either mount the file (docker-compose does this) …
GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json
# … or inline the JSON on one line instead:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Optional
# MCP_TRANSPORT=http     # http (default) | stdio
# MCP_PATH=/             # path the MCP endpoint is served on
# PORT=8000
# LOCAL_USER_EMAIL=      # who you are under MCP_TRANSPORT=stdio (no OAuth there)
